# Server Configuration
PORT=5052
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_super_strong_jwt_secret_here

# Database (MongoDB Atlas URI in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/saas?retryWrites=true&w=majority

# Redis (Cloud Redis credentials)
REDIS_HOST=your-redis-host.db.redis.io
REDIS_PORT=12041
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# Email Service (Gmail SMTP)
FROM=your_email@gmail.com
PASS=your_gmail_app_password

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
